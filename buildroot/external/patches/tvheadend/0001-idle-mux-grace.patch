   tvh_mutex_unlock(&mi->mi_output_lock);
 
   mpegts_mux_update_pids(mm);
 
   /* Stop mux? */
-  s->s_dvb_mux->mm_stop(s->s_dvb_mux, 0, SM_CODE_OK);
+  s->s_dvb_mux->mm_stop(s->s_dvb_mux, 0, stop_reason);
 }
 
