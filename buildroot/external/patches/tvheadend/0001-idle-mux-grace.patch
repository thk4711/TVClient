+/* Idle grace owns no subscription and never extends an existing deadline.
+ * mtimer callbacks and mux lifecycle operations run under global_lock. */
+static void
+mpegts_mux_idle_grace_cb ( void *aux )
+{
+  mpegts_mux_t *mm = aux;
+  mm->mm_idle_grace_pending = 0;
+  mpegts_mux_stop_now(mm, 0, SM_CODE_OK);
+}
+
+static void
+mpegts_mux_stop ( mpegts_mux_t *mm, int force, int reason )
+{
+  mpegts_mux_instance_t *mmi = mm->mm_active;
+  int grace = mmi ? mmi->mmi_input->mi_idle_grace : 0;
+
+  if (!force && reason == SM_CODE_OK && mmi && grace > 0 &&
+      mmi->mmi_input->mi_enabled && mpegts_mux_is_enabled(mm) &&
+      mclk() - atomic_add_s64(&mmi->mmi_input->mi_last_dispatch, 0) < sec2mono(2)) {
+    if (mpegts_mux_has_subscribers(mm, mm->mm_nicename)) {
+      mtimer_disarm(&mm->mm_idle_grace_timer);
+      mm->mm_idle_grace_pending = 0;
+      return;
+    }
+    if (!mm->mm_idle_grace_pending) {
+      if (grace > 2000) grace = 2000;
+      mm->mm_idle_grace_pending = 1;
+      mtimer_arm_rel(&mm->mm_idle_grace_timer, mpegts_mux_idle_grace_cb,
+                     mm, ms2mono(grace));
+      tvhdebug(LS_MPEGTS, "%s - idle mux grace %d ms", mm->mm_nicename, grace);
+    }
+    return;
+  }
+  mtimer_disarm(&mm->mm_idle_grace_timer);
+  mm->mm_idle_grace_pending = 0;
+  mpegts_mux_stop_now(mm, force, reason);
+}
+
 static void
 mpegts_mux_update_pids_cb ( void *aux )
 {
