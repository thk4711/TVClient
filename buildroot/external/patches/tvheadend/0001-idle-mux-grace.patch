@@ -954,13 +955,18 @@
   }
 
 no_pids:
+  /* A failed/unfinished service must not retain a bad session for recovery. */
+  if (mi->mi_idle_grace > 0 && s->s_type == STYPE_STD &&
+      (!(s->s_streaming_status & TSS_PACKETS) ||
